# Raw datasets (never committed, never modified)
dataset/
data/raw/*
!data/raw/.gitkeep

# Generated data
data/processed/*
!data/processed/.gitkeep

# Trained models ARE committed (the deployed app loads them, about 23 MB in total)

# Downloaded NLTK corpora
nltk_data/

# Virtual environments / caches
.venv/
venv/
env/
__pycache__/
*.pyc
.pytest_cache/
.streamlit/secrets.toml
